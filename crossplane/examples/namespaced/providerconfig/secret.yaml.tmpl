# Copy to secret.yaml (gitignored), fill in real values, then `kubectl apply`.
# Lives in the same namespace as the namespaced ProviderConfig that consumes
# it. `api_key` is required; `base_url` is optional.
apiVersion: v1
kind: Secret
metadata:
  name: archestra-creds
  namespace: crossplane-system
type: Opaque
stringData:
  credentials: |
    {
      "api_key": "arch_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "base_url": "https://app.archestra.ai"
    }
