# Copy to secret.yaml (gitignored) and fill in real values, then `kubectl apply`.
# `api_key` is required; `base_url` is optional and defaults to the public
# Archestra control plane.
apiVersion: v1
kind: Secret
metadata:
  name: archestra-creds
  namespace: crossplane-system
type: Opaque
stringData:
  credentials: |
    {
      "api_key": "arch_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
      "base_url": "https://app.archestra.ai"
    }
